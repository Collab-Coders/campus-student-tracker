generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Campus {
  id          String    @id @default(uuid())
  name        String
  address     String
  imageUrl    String
  description String
  students    Student[]
}

model Student {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String  @unique
  gpa       Decimal
  imageUrl  String
  status    String
  campusId  String?
  campus    Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)
}